# LLM API 配置
# 复制此文件为 .env 并填入实际的配置
# 确保 .env 文件已添加到 .gitignore 中，不会被提交到版本控制系统
#
# .env 由 src/config/config.py 在首次导入配置时自动加载，无需手动 export。
# 已存在于进程环境中的同名变量优先，不会被本文件覆盖。
# 若要彻底跳过本文件（例如强制走无 LLM 的降级路径，不做语义增强），设置 CAD2GRAPH_SKIP_DOTENV=1。
#
# 变量前缀：旧项目名称为 CAD_RULE_CHECKER_，现统一为 CAD2GRAPH_；
# 旧前缀仍被兼容（新前缀优先），见 src/config/config.py 的 ENV_PREFIX。

# 必需：OpenAI 兼容的 API Key
CAD2GRAPH_LLM_API_KEY=your_api_key_here

# 可选：自定义 API Base URL（会覆盖 settings.yaml 中的设置）
# 开发环境示例：https://api.openai.com/v1/
# 生产环境示例：https://open.bigmodel.cn/api/paas/v4/
CAD2GRAPH_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# 可选：自定义模型名称（会覆盖 settings.yaml 中的设置）
# 常用模型示例：gpt-4, gpt-3.5-turbo, glm-4-flash, claude-3-opus
CAD2GRAPH_LLM_MODEL=glm-4-flash


# ---------------------------------------------------------------------------
# VecFloorSeg baseline（可选，仅当 spatial.contour.algorithm = VecFloorSeg 时需要）
# ---------------------------------------------------------------------------
# VecFloorSeg 跑在**独立的 conda 环境**里（PyTorch 1.13 + cu117），由 CAD2Graph
# 通过子进程调用，因此本仓库自己的环境无需安装 PyTorch。
# 这里填写的值等价于 settings.yaml 的 spatial.contour.algorithm_params.VecFloorSeg，
# 但不会把机器相关的绝对路径带进版本库。

# VecFloorSeg 环境的解释器
VECFLOORSEG_PYTHON=C:\Users\<you>\miniconda3\envs\vecfloorseg\python.exe

# 训练产出的权重（路径形如 <out_dir>/<cfgname>/<seed>/ckpt/best1.ckpt）
# 注意：权重缺失时上游的 load_ckpt() 会静默返回 0，导致用随机权重推理而不报错，
# 因此适配层会提前校验该文件是否存在。
VECFLOORSEG_CKPT=D:\Dev\BIM\CAD2Graph\third_party\VecFloorSeg\results\CUBI\0\ckpt\best1.ckpt

# VecFloorSeg 仓库根目录；不设则回退到 <仓库>/third_party/VecFloorSeg
# VECFLOORSEG_ROOT=D:\Dev\BIM\CAD2Graph\third_party\VecFloorSeg
